# Medical insurance underwriting — application input model
# (English version of medical-underwriting.ncproj).
# System under test: ENISHI Life medical insurance application simulator
#                    https://modellogue.com/medical-underwriting/
#
# A companion to the NeoCEG model of the SAME specification (cause-effect graph):
#   https://neo-ceg.vercel.app/?file=https://sho1884.github.io/public-files/NeoCEG/Samples/OneMask-medical_insurance_underwriting_en.nceg
# NeoCEG draws the logic that derives the two results (main-contract class and
# rider decision) from the inputs; NeoCombi describes the same screen's input
# space as factors, levels and constraints, and generates the combinations to try.
#
# Three inputs exist on the screen only while their condition holds:
#   SinceDischarge        — only when there is a hospitalization in the last 5 years
#   OccupationalRisk      — only while employed
#   IncomeProtectionRider — only while employed
# The absent state is the _MASK_ level, pinned in both directions by a constraint
# pair (= and <>), so _MASK_ appears exactly when the field is hidden — never as a
# stand-in for "any value".
#
# This is a .ncproj (project): it carries the generated pairwise set (13 cases)
# and the full decision table (648 rows — 90 valid, 558 forbidden).

AgeBand:               18to64, 65to74, 75OrOlder
CurrentTreatment:      None, Ongoing
Hospitalization5y:     None, Yes
SinceDischarge:        Under2Years, 2YearsOrMore, _MASK_
Employment:            Employed, NotEmployed
OccupationalRisk:      Normal, Hazardous, _MASK_
IncomeProtectionRider: NotAttached, Attached, _MASK_

# SinceDischarge exists on the screen only when there is a hospitalization.
IF [Hospitalization5y] = "None" THEN [SinceDischarge]  = "_MASK_";
IF [Hospitalization5y] = "Yes"  THEN [SinceDischarge] <> "_MASK_";

# OccupationalRisk exists on the screen only while employed.
IF [Employment] = "NotEmployed" THEN [OccupationalRisk]  = "_MASK_";
IF [Employment] = "Employed"    THEN [OccupationalRisk] <> "_MASK_";

# IncomeProtectionRider exists on the screen only while employed.
IF [Employment] = "NotEmployed" THEN [IncomeProtectionRider]  = "_MASK_";
IF [Employment] = "Employed"    THEN [IncomeProtectionRider] <> "_MASK_";

